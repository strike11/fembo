# Start Postgres locally: npm run db:up
DATABASE_URL="postgresql://fembo:fembo@localhost:5432/fembo"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Chat provider: ollama for local dev, openrouter in production.
CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=tinydolphin
# OLLAMA_API_KEY=

# Production inference (server-side only).
# CHAT_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-2-9b-it:free

# Optional: faster call STT. Without these, the browser downloads Whisper tiny once.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Production payment contract (Stripe is the only implemented provider today).
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# S3-compatible object storage for custom companion art.
# STORAGE_ENDPOINT=https://objects.example.com
# STORAGE_PUBLIC_URL=https://cdn.example.com/fembo
# STORAGE_BUCKET=fembo
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
